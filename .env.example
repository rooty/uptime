PORT=8080
DB_PATH=./app.db

# Cloudflare Access. Leave both values empty for local development.
# Example: https://my-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Cloudflare Access application.
CLOUDFLARE_ACCESS_AUDIENCE=

# OpenAI-compatible API for Mail Diagnostics AI reports. Keep the key out of Git.
AI_API_KEY=

# Optional MxToolbox API key for blacklist diagnostics. Keep the key out of Git.
MXTOOLBOX_API_KEY=
